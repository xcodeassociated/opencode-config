{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "model": "vllm/qwen/qwen3.8-flash-next",
  "compaction": {
    "auto": true
  },
  "providers": {
    "vllm": {
      "name": "vllm",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "{env:OPENCODE_VLLM_BASE_URL}"
      },
      "models": {
        "qwen/qwen3.8-flash-next": {
          "modelID": "qwen/qwen3.8-flash-next",
          "name": "qwen/qwen3.8-flash-next",
          "capabilities": {
            "tools": true,
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ],
            "reasoning": {
              "supported": true
            }
          },
          "limit": {
            "context": 520000,
            "output": 32768
          },
          "settings": {
            "reasoningEffort": "xhigh"
          },
          "variants": [
            {
              "id": "no-thinking",
              "settings": {
                "reasoningEffort": "none"
              }
            },
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh"
              }
            }
          ]
        }
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "firecrawl*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "searxng*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "duckduckgo*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/private/tmp/**",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "build": {
      "mode": "all",
      "description": "OpenCode built-in `build` coding agent, used in primary and delegated subagent sessions. The `build` agent creates and updates a todo plan for every task, implements ordinary work directly, delegates only substantial independent work to another instance of the same `build` agent, and uses the `researcher` agent for external factual research. Before major code changes or decisions needing unavailable domain/product knowledge, the primary interactive `build` agent must obtain human plan approval with the `question` tool.",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "firecrawl*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "searxng*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "duckduckgo*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "external_directory",
          "resource": "/tmp/**",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "/private/tmp/**",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "build",
          "effect": "allow"
        },
        {
          "action": "subagent",
          "resource": "researcher",
          "effect": "allow"
        },
        {
          "action": "todowrite",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "chrome-devtools-mcp@latest"
        ],
        "disabled": true,
        "codemode": true
      },
      "playwright": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "@playwright/mcp@latest"
        ],
        "disabled": false,
        "codemode": true
      },
      "searxng": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "mcp-searxng@1.1.1"
        ],
        "environment": {
          "SEARXNG_URL": "{env:OPENCODE_SEARXNG_AI_URL}"
        },
        "disabled": false,
        "codemode": true
      },
      "firecrawl": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "firecrawl-mcp"
        ],
        "environment": {
          "FIRECRAWL_API_URL": "{env:OPENCODE_FIRECRAWL_AI_API_URL}",
          "FIRECRAWL_RETRY_MAX_ATTEMPTS": "{env:OPENCODE_FIRECRAWL_RETRY_MAX_ATTEMPTS}",
          "FIRECRAWL_API_KEY": "{env:OPENCODE_FIRECRAWL_AI_API_KEY}"
        },
        "disabled": false,
        "codemode": false
      },
      "shadcn": {
        "type": "local",
        "command": [
          "bunx",
          "--bun",
          "shadcn@latest",
          "mcp"
        ],
        "disabled": false,
        "codemode": true
      }
    }
  },
  "experimental": {
    "todo": true,
    "subagent_depth": 3
  },
  "plugins": [
    "opencode-cmux"
  ]
}
